# @script.name = "Login With AutoSignoff"
# @script.author = "Remi GASCOU (Podalirius)"
# @script.description = "Logs in to the system and auto signoff the last job if needed"
# @script.version = "1.0"
# @menu.path = "Login/Login With AutoSignoff"

# Login to the system and auto signoff the last job if needed.
DEF login($username, $password)
    MOVE CURSOR AT (1,1)
    MOVE CURSOR AT NEXT INPUTFIELD
    TYPE "$username"
    MOVE CURSOR AT NEXT INPUTFIELD
    TYPE "$password"
    PRESS ENTER
    autosignoff($username, $password)
    display_program_messages()
ENDDEF

# Auto signoff the last job if needed.
DEF autosignoff($username, $password)
    EXTRACT $title LINE 1
    IF $title CONTAINS "Attempt to Recover Interactive Job" THEN
        MOVE CURSOR AT (1,1)
        MOVE CURSOR AT NEXT INPUTFIELD
        TYPE "90"
        PRESS ENTER
        PRESS ENTER
        login($username, $password)
    ENDIF
ENDDEF

# Display Program Messages
DEF display_program_messages()
    EXTRACT $title LINE 1
    IF $title CONTAINS "Display Program Messages" THEN
        MOVE CURSOR AT (1,1)
        MOVE CURSOR AT NEXT INPUTFIELD
        PRESS ENTER
    ENDIF
ENDDEF

#===============================================================

# Check if the username and password are defined.
IF NOT ISSET($SESSION_USERNAME) OR NOT ISSET($SESSION_PASSWORD) THEN
    LOG "Username and password are not defined"
    INPUT "Enter the username: " $SESSION_USERNAME
    INPUT "Enter the password: " $SESSION_PASSWORD
ENDIF

login($SESSION_USERNAME, $SESSION_PASSWORD)
